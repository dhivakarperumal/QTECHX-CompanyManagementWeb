{
  "name": "q-techx-web",
  "private": true,
  "scripts": {
    "backend": "npm --prefix Backend run start",
    "build": "npm --prefix Frontend install --include=dev && npm --prefix Frontend run build && npm --prefix Backend install --omit=dev",
    "frontend": "npm --prefix Frontend run dev",
    "start": "npm --prefix Backend run start",
    "dev": "npx concurrently \"npm run backend\" \"npm run frontend\""
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "framer-motion": "^12.42.2",
    "react-slick": "^0.31.0",
    "react-to-print": "^3.3.0",
    "react-toastify": "^11.1.0",
    "recharts": "^3.10.1",
    "slick-carousel": "^1.8.1"
  }
}
